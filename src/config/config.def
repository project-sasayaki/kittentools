#ifndef SECTION
#define SECTION(s, comment)
#endif
#ifndef COMMENT
#define COMMENT(comment)
#endif
#ifndef NEWLINE
#define NEWLINE()
#endif
#ifndef ENDSECTION
#define ENDSECTION(s)
#endif

COMMENT("The main config file")
COMMENT("")

SECTION(display, "Display settings")
COMMENT("Use DIPSW for resolution")
COMMENT("This option will overwrite your custom resolution setting")
CFG_bool(display, dipsw, true, "")
COMMENT("the width resolution")
CFG_int(display, width, 1360, "")
COMMENT("the height resolution")
CFG_int(display, height, 768, "")
COMMENT("Should windowed games run borderless")
CFG_bool(display, borderless, false, "")
COMMENT("Set to Fullscreen")
CFG_bool(display, fullscreen, false, "")
COMMENT("Resolution scale of rendering (1=disable, 2=2x, 4=4x, 8=8x)")
CFG_int(display, render_scale, 1, "")
COMMENT("MSAA sample count for the offscreen scene render target(0 = disabled, 2=2x, 4=4x, 8=8x, 16=16x)")
CFG_int(display, msaa_samples, 0, "")
COMMENT("Anisotropic filtering level (0=disabled, 1-16, clamped to hardware max)")
CFG_int(display, anisotropic, 0, "")
ENDSECTION(display)

SECTION(network, "")
COMMENT("If true, the loader will handle network features of the game, otherwise launch the game in offline mode.")
CFG_bool(network, enable, true, "")
COMMENT("the hostname or IP address of the All.Net server you wish to use here")
COMMENT("Note that 127.0.0.1, localhost etc are specifically rejected.")
CFG_str(network, redirect, "127.0.0.1", "")
COMMENT("the router address of the server you wish to use here, should start with 10")
CFG_str(network, router, "10.0.0.254", "")
COMMENT("Network range of In-Shop network (LAN)")
CFG_str(network, subnet, "192.168.37.0/24", "")
COMMENT("When simulateNetwork enabled, Kitten simulates ServerBox network traffic,")
COMMENT("allowing both ServerBox and the game to run on the same PC.")
COMMENT("Note: All ports listened to by ServerBox will be incremented by 1.")
COMMENT("To use in-store mode, disable this option and")
COMMENT("run ServerBox on a separate PC or virtual machine.")
CFG_bool(network, simulateNetwork, false, "")
CFG_str(network, game_ip, "", "LAN IP for the game (empty = wildcard binds).")
CFG_str(network, bind_ip, "", "Dedicated LAN IP for ServerBox (empty = disabled).")
ENDSECTION(network)

SECTION(sysconf, "")
COMMENT("Trace logging (0) is intensive, and should only be used when debugging")
COMMENT("6 = Fatal")
COMMENT("5 = Error")
COMMENT("4 = Warn")
COMMENT("3 = Info")
COMMENT("2 = Game")
COMMENT("1 = Debug")
COMMENT("0 = Trace")
CFG_int(sysconf, log_level, 3, "")
NEWLINE()
COMMENT("DIP Switch values, should be read in binary as switches")
COMMENT("0x38 = 1360x768")
COMMENT("0x30 = 1280x1024")
COMMENT("0x28 = 1024x600")
COMMENT("0x20 = 800x600")
COMMENT("0x18 = 1280x768")
COMMENT("0x10 = 1024x768")
COMMENT("0x08 = 800x480")
COMMENT("0x00 = 640x480")
COMMENT("0x02 = Chinese Localization (Only for D5 EXP 2.0)")
CFG_hex(sysconf, dipsw, 2, 0x38, "") 
NEWLINE()
COMMENT("Board region. 0 = JPN, 1 = USA, 2 = EXP")
CFG_int(sysconf, region, 0, "")
COMMENT("The emulated keychip game id, Kitten might overwrite this if the ELF is recognized.")
CFG_str(sysconf, game_id, "SBQZ", "")
COMMENT("The emulated keychip network configuration.")
CFG_bool(sysconf, enableDHCP, true, "")
CFG_ipv4(sysconf, ip_address, 192, 168, 37, 101, "")
CFG_ipv4(sysconf, subnet_mask, 255, 255, 255, 0, "")
CFG_ipv4(sysconf, gateway, 192, 168, 37, 254, "")
CFG_ipv4(sysconf, primary_dns, 192, 168, 37, 254, "")
CFG_ipv4(sysconf, secondary_dns, 0, 0, 0, 0, "")
NEWLINE()
COMMENT("The emulated keychip serial number")
CFG_str(sysconf, keychip_serial, "AAJE-01A99999999", "")
COMMENT("Serial number of baseboard.")
CFG_str(sysconf, pcb_serial, "A80E-02A88888888", "")
COMMENT("Skip card reader initialization")
COMMENT("Issuing a temporary license for reissue or license renewal requires the card reader ")
COMMENT("to be properly initialized. Skip initialization if neither operation is required.")
CFG_bool(sysconf, skipInitCard, false, "")
ENDSECTION(sysconf)

SECTION(Coins, "Coins settings")
CFG_bool(Coins, freeplay, false, "")
COMMENT("Number of coins required per credit.")
CFG_int(Coins, credit_rate, 1, "")
COMMENT("Required credits to start a game.")
CFG_int(Coins, start, 2, "")
COMMENT("Required credits to continue a game.")
CFG_int(Coins, continues, 2, "")
COMMENT("Required credits to purchase an Initial D Driver License.")
CFG_int(Coins, card, 3, "")
COMMENT("Credits required to add hitherto unpurchased new cars.")
CFG_int(Coins, car, 1, "")
ENDSECTION(Coins)

SECTION(path, "")
COMMENT("Set to true to emulate JVS board")
COMMENT("For Windows, you have to emulate JVS to input on this version of Kitten.")
// COMMENT("If this is set to false, the loader will route the traffic to the serial device")
CFG_bool(path, emulate_jvs, true, "")
// COMMENT("Define the path to pass the JVS packets to if JVS is not being emulated")
// CFG_str(path, jvs_path, "COM4", "")
// COMMENT("Define the path to pass the first serial port to, this one usually for driveboard")
// CFG_str(path, serial0, "COM1", "")
// COMMENT("Define the path to pass the second serial port to, this one usually for card reader")
// CFG_str(path, serial1, "COM2", "")
COMMENT("Define the path to the sram.bin file")
CFG_str(path, sram_path, "kitten/sram.bin", "")
COMMENT("Define the path to the eeprom.bin file")
CFG_str(path, eeprom_path, "kitten/eeprom.bin", "")
ENDSECTION(path)

NEWLINE()
COMMENT("-----------------------------------------------------------------------------")
COMMENT("Input settings")
COMMENT("-----------------------------------------------------------------------------")
COMMENT("Input implementations are ported from segatools, for advanced input setup, please")
COMMENT("refer to segatools setup guide for IDTA or IDZ.")
COMMENT(" ")
COMMENT("Keyboard bindings are specified as hexadecimal (prefixed with 0x) or decimal")
COMMENT("(not prefixed with 0x) virtual-key codes, a list of which can be found here:")
COMMENT(" ")
COMMENT("https://docs.microsoft.com/en-us/windows/win32/inputdev/virtual-key-codes")
COMMENT(" ")
COMMENT("This is, admittedly, not the most user-friendly configuration method in the")
COMMENT("world. An improved solution will be provided later.")
SECTION(io3, "")
COMMENT("Test button virtual-key code. Default is the F1 key.")
CFG_hex(io3, test, 1, 0x70, "") 
COMMENT("Service button virtual-key code. Default is the F2 key.")
CFG_hex(io3, service, 1, 0x71, "")
COMMENT("Keyboard button to increment coin counter. Default is the F3 key")
CFG_hex(io3, coin, 1, 0x72, "")
NEWLINE()
COMMENT("Input API selection for IO3 input emulator.")
COMMENT("Set xinput (1) to use a gamepad and dinput (2) to use a steering wheel.")
CFG_int(io3, mode, 1, "")
COMMENT("Adjust scaling for steering wheel input.")
COMMENT(" ")
COMMENT("This setting scales the steering wheel input so that the maximum positive")
COMMENT("and minimum negative steering inputs reported in the operator menu's input")
COMMENT("test screen do not exceed the value below. The maximum possible value is 128,")
COMMENT("and the value that matches the input range of a real cabinet is 128.")
COMMENT(" ")
COMMENT("NOTE: This is not the same thing as DirectInput steering wheel movement")
COMMENT("range! Segatools cannot control the maximum angle of your physical steering")
COMMENT("wheel controller, this setting is vendor-specific and can only be adjusted")
COMMENT("in the Control Panel.")
CFG_int(io3, restrict_, 128, "")
ENDSECTION(io3)

SECTION(ffb, "Force Feedback")
COMMENT("Enable force feedback")
CFG_bool(ffb, enable, true, "")
COMMENT("Constant force strength, used for centering spring effect")
CFG_int(ffb, constantForceStrength, 100, "")
COMMENT("Damper strength, used for steering wheel damper effect")
CFG_int(ffb, damperStrength, 100, "")
COMMENT("Rumble strength, used for road surface effects")
CFG_int(ffb, rumbleStrength, 100, "")
COMMENT("Rumble duration factor from ms to µs, used to scale the duration of the rumble effect")
CFG_int(ffb, rumbleDuration, 100, "")
COMMENT("Sets the minimum amount of weight or stiffness in the wheel")
CFG_int(ffb, baseDamperStrength, 20, "")
COMMENT("Creates a small no-force zone at the wheel's center")
CFG_int(ffb, deadBand, 20, "")
ENDSECTION(ffb)

SECTION(xinput, "Xinput Settings")
CFG_int(xinput, deviceIndex, 0, "Index of the XInput controller to use, valid range is 0-3")
COMMENT("Button mappings, one button name per entry")
COMMENT("Available names: DPAD_UP, DPAD_DOWN, DPAD_LEFT, DPAD_RIGHT, START, BACK, GUIDE,")
COMMENT("LTHUMB, RTHUMB, LB, RB, LT, RT, A, B, X, Y")
COMMENT("A raw button mask may be used instead, e.g. 0x1000 for A")
COMMENT("Note: GUIDE requires XInputGetStateEx and is not reported by XInputGetState")
COMMENT("XInput bindings")
COMMENT(" ")
COMMENT("Left Stick           Steering")
COMMENT("Right Stick          (Steering) when \"singleStickSteering\" is disabled")
COMMENT("Left Trigger         Brake")
COMMENT("Right Trigger        Accelerator")
COMMENT("Left Stick Click     Left")
COMMENT("Right Stick Click    Right")
COMMENT("Left Shoulder        Shift Down")
COMMENT("Right Shoulder       Shift Up")
COMMENT("Start/A              Start")
COMMENT("Back/B               View Change")
COMMENT("X                    Shift Up")
COMMENT("Y                    Shift Down")
COMMENT("D-Pad                D-Pad")
NEWLINE()
COMMENT("Use the left thumbstick for steering instead of both on XInput Controllers.")
COMMENT("Not recommended as it will not give you the precision needed for this game.")
CFG_bool(xinput, singleStickSteering, true, "")
COMMENT("Use a linear steering response (exponent = 1).")
COMMENT("When false, the non-linear 'steeringExponent' curve below is used instead,")
COMMENT("which gives a flatter center (easier to hold a straight line) and steeper edges")
COMMENT("- more like a real steering wheel and far less twitchy on a thumbstick.")
COMMENT("Default is false (wheel-like progressive curve).")
CFG_bool(xinput, linearSteering, true, "")
COMMENT("Steering response curve exponent. Only used when linearSteering is false.")
COMMENT("  1 = linear (same as linearSteering = true)")
COMMENT("  2 = mild progressive, calmer center (default)")
COMMENT("  3 = strong progressive, very flat center (most wheel-like)")
COMMENT("  4-5 = even flatter center / steeper edge")
COMMENT("Higher values reduce sensitivity near the stick center.")
CFG_int(xinput, steeringExponent, 2, "1 = linear, 2 = mild, 3 = strong wheel feel")
COMMENT("Configure deadzones for the left and right thumbsticks")
CFG_int(xinput, leftStickDeadzone, 7849, "Max = 32767")
CFG_int(xinput, rightStickDeadzone, 8689, "Max = 32767")
CFG_str(xinput, start, "A", "Button mapping for start")
CFG_str(xinput, viewChg, "B", "Button mapping for view change")
CFG_str(xinput, up, "DPAD_UP", "Button mapping for D-pad up")
CFG_str(xinput, down, "DPAD_DOWN", "Button mapping for D-pad down")
CFG_str(xinput, left, "DPAD_LEFT", "Button mapping for D-pad left")
CFG_str(xinput, right, "DPAD_RIGHT", "Button mapping for D-pad right")
CFG_str(xinput, shiftDn, "LB", "Button mapping for shift down")
CFG_str(xinput, shiftUp, "RB", "Button mapping for shift up")
CFG_str(xinput, accel, "RT", "Throttle source: trigger (LT/RT) or a digital button name (e.g. A)")
CFG_str(xinput, brake, "LT", "Brake source: trigger (LT/RT) or a digital button name (e.g. B)")
CFG_str(xinput, coin, "Y", "Button mapping for inserting a coin")
ENDSECTION(xinput)

SECTION(dinput, "DirectInput settings")
COMMENT("Name of the DirectInput wheel to use (or any text that occurs in its name)")
COMMENT("Example: G29")
COMMENT(" ")
COMMENT("If this is left blank then the first DirectInput device will be used.")
CFG_str(dinput, deviceName, "", "")
COMMENT("Name of the DirectInput pedals to use (or any subset thereof).")
COMMENT("Leave blank if you do not have separate pedals; aka the pedals are part of")
COMMENT("the wheel.")
COMMENT(" ")
COMMENT("The pedals will be mapped to the accelAxis and brakeAxis.")
CFG_str(dinput, pedalsName,"", "")
COMMENT("Name of the positional shifter to use (or any subset thereof).")
COMMENT("Leave blank if you do not have a positional shifter; a positional shifter")
COMMENT("will be simulated using the configured Shift Down and Shift Up buttons")
COMMENT("in this case.")
COMMENT(" ")
COMMENT("Can be the same device as the wheel.")
COMMENT(" ")
COMMENT("Example: G29")
CFG_str(dinput, shifterName, "", "")
COMMENT("Pedal mappings. Valid axis names are:")
COMMENT(" ")
COMMENT("X, Y, Z, RX, RY, RZ, U, V")
COMMENT(" ")
COMMENT("(U and V are old names for Slider 1 and Slider 2).")
COMMENT("The examples below are valid for a Logitech G29.")
CFG_str(dinput, brakeAxis, "RZ", "")
CFG_str(dinput, accelAxis, "Y", "")
COMMENT("DirectInput button numbers to map to menu inputs. Note that buttons are")
COMMENT("numbered from 1; some software numbers buttons from 0.")
CFG_int(dinput, start, 5, "")
CFG_int(dinput, viewChg, 6, "")
COMMENT("Button mappings for the simulated six-speed shifter.")
CFG_int(dinput, shiftDn, 8, "")
CFG_int(dinput, shiftUp, 9, "")
COMMENT("Optional DirectInput button numbers (1-based) for selecting each gear; 0 = disabled.")
CFG_int(dinput, gear1, 0, "")
CFG_int(dinput, gear2, 0, "")
CFG_int(dinput, gear3, 0, "")
CFG_int(dinput, gear4, 0, "")
CFG_int(dinput, gear5, 0, "")
CFG_int(dinput, gear6, 0, "")
CFG_int(dinput, up, 0, "Button mapping for D-pad up (0 = use wheel POV/hat)")
CFG_int(dinput, down, 0, "Button mapping for D-pad down (0 = use wheel POV/hat)")
CFG_int(dinput, left, 0, "Button mapping for D-pad left (0 = use wheel POV/hat)")
CFG_int(dinput, right, 0, "Button mapping for D-pad right (0 = use wheel POV/hat)")
CFG_int(dinput, coin, 0, "Button mapping for inserting a coin (0 = disabled)")
COMMENT("Invert the accelerator and or brake axis")
COMMENT("(Needed when using DirectInput for the Dualshock 4 for example)")
CFG_bool(dinput, reverseAccelAxis, false, "")
CFG_bool(dinput, reverseBrakeAxis, false, "")
ENDSECTION(dinput)

NEWLINE()
COMMENT("-----------------------------------------------------------------------------")
SECTION(wmmt3, "Wangan Midnight Maximum Tune 3 / 3DX / 3DX+ (Namco System N2)")
COMMENT("Everything to set for these games is in this section; the sections above are for other games")
COMMENT("([sysconf] log_level aside, which applies before the game is known).")
NEWLINE()
COMMENT("--- Screen ---")
CFG_bool(wmmt3, fullscreen, false, "")
COMMENT("Window without a title bar and border")
CFG_bool(wmmt3, borderless, false, "")
COMMENT("true: the game renders at the cabinet's 640x480, in a 640x480 window or scaled up to the monitor when fullscreen")
COMMENT("false: it renders at the largest 4:3 size that fits the window below (or the monitor when fullscreen)")
CFG_bool(wmmt3, cabinet_resolution, true, "")
COMMENT("Window size when cabinet_resolution = false")
CFG_int(wmmt3, window_width, 1280, "")
CFG_int(wmmt3, window_height, 960, "")
COMMENT("Stretch the 4:3 picture over the whole window instead of keeping its shape with black bars at the sides")
CFG_bool(wmmt3, stretch, false, "")
COMMENT("Render at 2, 4 or 8 times the size and scale down (supersampling; 1 = off)")
CFG_int(wmmt3, render_scale, 1, "")
COMMENT("Multisampling of the picture (0 = off, 2, 4, 8, 16)")
CFG_int(wmmt3, msaa_samples, 0, "")
COMMENT("Anisotropic filtering of the game's textures (0 = off, 1-16)")
CFG_int(wmmt3, anisotropic, 0, "")
NEWLINE()
COMMENT("--- Coins ---")
COMMENT("Game cost and the other coin options are set in the game's test mode (COIN OPTIONS), as on the cabinet.")
COMMENT("true: free play whatever the test mode says")
CFG_bool(wmmt3, free_play, false, "")
NEWLINE()
COMMENT("--- Linked play ---")
COMMENT("Linked play between cabinets (one PC = one cabinet). Every PC must be in the same /24")
COMMENT("(first three numbers of the IP equal), on a LAN or a VPN that carries multicast,")
COMMENT("with UDP and TCP port 50765 open. Give each PC its own PCB ID in the test mode.")
CFG_bool(wmmt3, linked_play, false, "")
COMMENT("The network the cabinets share; this PC's address in it is found automatically")
CFG_str(wmmt3, link_subnet, "192.168.1.0/24", "")
COMMENT("This PC's address in that network, named outright (empty = found from link_subnet)")
CFG_str(wmmt3, link_ip, "", "")
NEWLINE()
COMMENT("--- Card ---")
COMMENT("Card files, YaCardEmu compatible: one <name>.bin per card (3 tracks x 69 bytes).")
COMMENT("Folder holding the card files, relative to the game folder")
CFG_str(wmmt3, card_dir, "cards", "")
COMMENT("The card that goes into the reader")
CFG_str(wmmt3, card_file, "card.bin", "")
COMMENT("Insert the card by itself whenever the game asks for one")
CFG_bool(wmmt3, card_auto_insert, false, "")
COMMENT("Reading and writing a card take as long as on the cabinet's reader")
CFG_bool(wmmt3, card_speed_emulation, true, "")
COMMENT("Card print images (<card>.bin.png). The reader prints in its own ROM font, so this is")
COMMENT("the closest stand-in: a TrueType file to load (empty = use an installed font) and its name.")
COMMENT("Example: the cabinet OS's usr/share/fonts/truetype/kochi/kochi-gothic-subst.ttf, \"Kochi Gothic\"")
CFG_str(wmmt3, print_font_file, "", "")
CFG_str(wmmt3, print_font_name, "MS Gothic", "")
COMMENT("Optional 640x1019 image of the blank card to print onto (empty = text only, transparent)")
CFG_str(wmmt3, print_template, "", "")
NEWLINE()
COMMENT("--- Keyboard ---")
COMMENT("Virtual-key codes of the cabinet's switches, for any input_mode (0 = none)")
COMMENT("https://docs.microsoft.com/en-us/windows/win32/inputdev/virtual-key-codes")
COMMENT("Test (0x70 = F1), service (F2), coin (F3), insert the card (F4), intrude / 乱入 (F5)")
CFG_hex(wmmt3, test_key, 2, 0x70, "")
CFG_hex(wmmt3, service_key, 2, 0x71, "")
CFG_hex(wmmt3, coin_key, 2, 0x72, "")
CFG_hex(wmmt3, card_key, 2, 0x73, "")
CFG_hex(wmmt3, intrude_key, 2, 0x74, "")
NEWLINE()
COMMENT("--- Controller ---")
COMMENT("1 = XInput gamepad (the xinput_ settings), 2 = DirectInput steering wheel (the dinput_ and ffb_ settings)")
CFG_int(wmmt3, input_mode, 1, "")
COMMENT("Steering at full lock, out of 128 (128 = the cabinet's full range)")
CFG_int(wmmt3, steering_range, 128, "")
NEWLINE()
COMMENT("--- XInput gamepad (input_mode = 1) ---")
COMMENT("Which controller, 0-3")
CFG_int(wmmt3, xinput_device, 0, "")
COMMENT("Button names: DPAD_UP, DPAD_DOWN, DPAD_LEFT, DPAD_RIGHT, START, BACK, LTHUMB, RTHUMB, LB, RB, LT, RT, A, B, X, Y, none")
CFG_str(wmmt3, xinput_start, "A", "")
CFG_str(wmmt3, xinput_view_change, "B", "")
CFG_str(wmmt3, xinput_up, "DPAD_UP", "")
CFG_str(wmmt3, xinput_down, "DPAD_DOWN", "")
CFG_str(wmmt3, xinput_left, "DPAD_LEFT", "")
CFG_str(wmmt3, xinput_right, "DPAD_RIGHT", "")
COMMENT("The cabinet's six-speed shifter is moved one gear at a time")
CFG_str(wmmt3, xinput_shift_down, "LB", "")
CFG_str(wmmt3, xinput_shift_up, "RB", "")
COMMENT("Pedals: a trigger (LT, RT) or a button")
CFG_str(wmmt3, xinput_accel, "RT", "")
CFG_str(wmmt3, xinput_brake, "LT", "")
CFG_str(wmmt3, xinput_coin, "Y", "")
COMMENT("Intrude (乱入) switch")
CFG_str(wmmt3, xinput_intrude, "X", "")
COMMENT("true: steer with the left stick only; false: with the average of both sticks")
CFG_bool(wmmt3, xinput_single_stick_steering, true, "")
COMMENT("true: steering follows the stick directly; false: it follows the curve below, calmer around the centre")
CFG_bool(wmmt3, xinput_linear_steering, true, "")
COMMENT("Curve when xinput_linear_steering = false: 1 = linear, 2 = mild, 3 = strong, 4-5 = flatter still at the centre")
CFG_int(wmmt3, xinput_steering_exponent, 2, "")
COMMENT("Stick dead zones, out of 32767")
CFG_int(wmmt3, xinput_left_deadzone, 7849, "")
CFG_int(wmmt3, xinput_right_deadzone, 8689, "")
NEWLINE()
COMMENT("--- DirectInput steering wheel (input_mode = 2) ---")
COMMENT("Devices, by any text that occurs in their name (example: G29). Wheel: empty = the first DirectInput device.")
COMMENT("Pedals and shifter: empty = they are part of the wheel. The shifter is the device carrying the two shift buttons.")
CFG_str(wmmt3, dinput_wheel, "", "")
CFG_str(wmmt3, dinput_pedals, "", "")
CFG_str(wmmt3, dinput_shifter, "", "")
COMMENT("Pedal axes: X, Y, Z, RX, RY, RZ, U, V (U and V are sliders 1 and 2)")
CFG_str(wmmt3, dinput_accel_axis, "Y", "")
CFG_str(wmmt3, dinput_brake_axis, "RZ", "")
CFG_bool(wmmt3, dinput_reverse_accel_axis, false, "")
CFG_bool(wmmt3, dinput_reverse_brake_axis, false, "")
COMMENT("Buttons, numbered from 1 (some software numbers them from 0); 0 = none")
CFG_int(wmmt3, dinput_start, 5, "")
CFG_int(wmmt3, dinput_view_change, 6, "")
COMMENT("The cabinet's six-speed shifter is moved one gear at a time")
CFG_int(wmmt3, dinput_shift_down, 8, "")
CFG_int(wmmt3, dinput_shift_up, 9, "")
COMMENT("Menu directions (0 = the wheel's POV hat only)")
CFG_int(wmmt3, dinput_up, 0, "")
CFG_int(wmmt3, dinput_down, 0, "")
CFG_int(wmmt3, dinput_left, 0, "")
CFG_int(wmmt3, dinput_right, 0, "")
COMMENT("Coin, insert the card, test, service, intrude (乱入)")
CFG_int(wmmt3, dinput_coin, 0, "")
CFG_int(wmmt3, dinput_card, 0, "")
CFG_int(wmmt3, dinput_test, 0, "")
CFG_int(wmmt3, dinput_service, 0, "")
CFG_int(wmmt3, dinput_intrude, 0, "")
NEWLINE()
COMMENT("--- Force feedback (DirectInput steering wheel) ---")
CFG_bool(wmmt3, ffb_enable, true, "")
COMMENT("Strength of the side force and of the damper, 0-100")
CFG_int(wmmt3, ffb_constant_force, 100, "")
CFG_int(wmmt3, ffb_damper, 100, "")
COMMENT("Least weight in the wheel, and a zone without force at its centre")
CFG_int(wmmt3, ffb_base_damper, 20, "")
CFG_int(wmmt3, ffb_dead_band, 20, "")
COMMENT("Reverse the direction of the steering board's reflect (side) force")
CFG_bool(wmmt3, ffb_invert, false, "")
NEWLINE()
COMMENT("--- Sound ---")
COMMENT("OpenAL to play the game's sound through, installed by the player like the Cg Toolkit (OpenAL 1.1 or OpenAL Soft, 32-bit)")
COMMENT("A name is searched for in the game folder, then the system; a full path works too")
COMMENT("Empty, or not installed: the game runs without sound")
CFG_str(wmmt3, openal_dll, "OpenAL32.dll", "")
NEWLINE()
COMMENT("--- Load times ---")
COMMENT("Load times like the cabinet's: charge each file read what its hard disk (WD800BB through an encrypted partition) would take")
CFG_bool(wmmt3, disk_speed_emulation, true, "")
COMMENT("Effective read rate of disk and decryption together, in MB/s, and the time of one seek in ms (estimates, tune against a real cabinet)")
CFG_int(wmmt3, disk_mbps, 30, "")
CFG_int(wmmt3, disk_seek_ms, 13, "")
COMMENT("Memory of the cabinet in MB (the board carries 1 GB or 2 GB; 0 = no limit) and how much of it the system")
COMMENT("and the game hold (estimate). Linux keeps the files it has read in what is left, so they load again without")
COMMENT("the disk; once that is full it drops the least recently read, and those take disk time again.")
CFG_int(wmmt3, cabinet_ram_mb, 1024, "")
CFG_int(wmmt3, cabinet_used_mb, 450, "")
NEWLINE()
COMMENT("--- Dongle ---")
COMMENT("Serial number of the emulated HASP dongle, written as test mode shows it: two six-digit halves")
COMMENT("New cards are numbered from it")
CFG_str(wmmt3, hasp_serial, "000000-000001", "")
COMMENT("3DX+ only: serial number of its second dongle")
CFG_str(wmmt3, hasp2_serial, "000000-000002", "")
ENDSECTION(wmmt3)

#undef CFG_str
#undef CFG_int
